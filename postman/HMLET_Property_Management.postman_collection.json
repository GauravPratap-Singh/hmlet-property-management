{
  "info": {
    "name": "HMLET Property Management API",
    "description": "Auth (JWT), Properties, Units, Members, and Contracts endpoints. Run requests top-to-bottom within a folder — the create requests auto-capture ids/tokens into collection variables used by later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "property_id", "value": "" },
    { "key": "unit_id", "value": "" },
    { "key": "member_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.access_token) {",
                  "    pm.collectionVariables.set('access_token', res.data.access_token);",
                  "    pm.collectionVariables.set('refresh_token', res.data.refresh_token);",
                  "}",
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_admin\",\n  \"email\": \"postman_admin@example.com\",\n  \"password\": \"PostmanPass123!\",\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.access_token) {",
                  "    pm.collectionVariables.set('access_token', res.data.access_token);",
                  "    pm.collectionVariables.set('refresh_token', res.data.refresh_token);",
                  "}",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_admin\",\n  \"password\": \"PostmanPass123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access) {",
                  "    pm.collectionVariables.set('access_token', res.access);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "Create Property",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.property && res.data.property.id) {",
                  "    pm.collectionVariables.set('property_id', res.data.property.id);",
                  "}",
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"property_name\": \"Sunset Apartments\",\n  \"address_line1\": \"123 Main St\",\n  \"postcode\": \"560001\",\n  \"country\": \"India\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/properties/",
              "host": ["{{base_url}}"],
              "path": ["api", "properties", ""]
            }
          }
        },
        {
          "name": "List Properties",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": {
              "raw": "{{base_url}}/api/properties/",
              "host": ["{{base_url}}"],
              "path": ["api", "properties", ""]
            }
          }
        },
        {
          "name": "Get Property Detail",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": {
              "raw": "{{base_url}}/api/properties/{{property_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "properties", "{{property_id}}", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Units",
      "item": [
        {
          "name": "Create Unit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.unit && res.data.unit.id) {",
                  "    pm.collectionVariables.set('unit_id', res.data.unit.id);",
                  "}",
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unit_number\": \"101\",\n  \"monthly_rent\": \"1500.00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/properties/{{property_id}}/units/",
              "host": ["{{base_url}}"],
              "path": ["api", "properties", "{{property_id}}", "units", ""]
            }
          }
        },
        {
          "name": "List Units",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": {
              "raw": "{{base_url}}/api/units/",
              "host": ["{{base_url}}"],
              "path": ["api", "units", ""]
            }
          }
        },
        {
          "name": "List Units (filter by status=available)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": {
              "raw": "{{base_url}}/api/units/?status=available",
              "host": ["{{base_url}}"],
              "path": ["api", "units", ""],
              "query": [{ "key": "status", "value": "available" }]
            }
          }
        },
        {
          "name": "List Units (filter by status=occupied)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": {
              "raw": "{{base_url}}/api/units/?status=occupied",
              "host": ["{{base_url}}"],
              "path": ["api", "units", ""],
              "query": [{ "key": "status", "value": "occupied" }]
            }
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "Create Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.member && res.data.member.id) {",
                  "    pm.collectionVariables.set('member_id', res.data.member.id);",
                  "}",
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Alice\",\n  \"last_name\": \"Tenant\",\n  \"email\": \"alice.tenant@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/members/",
              "host": ["{{base_url}}"],
              "path": ["api", "members", ""]
            }
          }
        },
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": {
              "raw": "{{base_url}}/api/members/",
              "host": ["{{base_url}}"],
              "path": ["api", "members", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Contracts",
      "item": [
        {
          "name": "Create Contract",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member_id\": {{member_id}},\n  \"unit_id\": {{unit_id}},\n  \"start_date\": \"2026-01-01\",\n  \"end_date\": \"2026-12-31\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/contracts/",
              "host": ["{{base_url}}"],
              "path": ["api", "contracts", ""]
            }
          }
        },
        {
          "name": "Create Contract (overlapping - expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member_id\": {{member_id}},\n  \"unit_id\": {{unit_id}},\n  \"start_date\": \"2026-06-01\",\n  \"end_date\": \"2026-07-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/contracts/",
              "host": ["{{base_url}}"],
              "path": ["api", "contracts", ""]
            }
          }
        },
        {
          "name": "List Contracts",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": {
              "raw": "{{base_url}}/api/contracts/",
              "host": ["{{base_url}}"],
              "path": ["api", "contracts", ""]
            }
          }
        },
        {
          "name": "List Active Contracts",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": {
              "raw": "{{base_url}}/api/contracts/?active=true",
              "host": ["{{base_url}}"],
              "path": ["api", "contracts", ""],
              "query": [{ "key": "active", "value": "true" }]
            }
          }
        }
      ]
    }
  ]
}
